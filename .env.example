# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)
# 둘 다 비워두면 LLM 없이 검색 결과 기반(추출형) 답변으로 동작합니다.
# 둘 다 있으면 Claude 를 먼저 씁니다 (application.yml 의 rag.llm.provider 로 고정 가능).

# Anthropic Claude (sk-ant-...)
ANTHROPIC_API_KEY=

# OpenAI (sk-proj-...)
OPENAI_API_KEY=
# (선택) 사용할 OpenAI 모델. 기본값 gpt-5.6-sol
# OPENAI_MODEL=gpt-5.6-sol
